# Local AI Lab configuration. Copy to ".env" (repo root) and edit.
# Restart the backend after changes. Runtime options (offline mode, limits,
# allowed models) are edited on the Settings page instead.

# --- model runtime -----------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default chat model and embedding model (must be pulled with `ollama pull`)
DEFAULT_MODEL=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text

# --- privacy -----------------------------------------------------------------
# Offline-Only mode is ON for a fresh install (can be toggled in Settings).
OFFLINE_ONLY_DEFAULT=true
# Extra hosts reachable in Offline-Only mode (loopback is always allowed).
# Docker: add the Ollama container name, e.g. localhost,127.0.0.1,::1,ollama
OFFLINE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
NETWORK_GUARD_ENABLED=true

# --- optional Ollama Cloud (only works when Offline-Only mode is OFF) ---------
OLLAMA_CLOUD_ENABLED=false
# Create a key at https://ollama.com/settings/keys . Never commit a real key.
OLLAMA_API_KEY=

# --- server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Turn on when the API is reachable by other people or other machines.
AUTH_ENABLED=false
ALLOW_REGISTRATION=true
LOG_LEVEL=INFO
# DATA_DIR=./backend/data

# --- ML / MLOps --------------------------------------------------------------
ML_BASELINE_ENABLED=true
MLFLOW_ENABLED=true

# --- access guards (v1.2) ----------------------------------------------------
# Without AUTH_ENABLED only these client networks are served (loopback by default),
# and requests whose Host header is not one of LOCAL_HOST_NAMES are refused (DNS rebinding).
# UNAUTHENTICATED_NETWORKS=127.0.0.0/8,::1/128
# LOCAL_HOST_NAMES=localhost,127.0.0.1,::1

# --- documents ---------------------------------------------------------------
# pypdf (BSD, default) or pymupdf (AGPL-3.0 – only if your distribution complies; pip install pymupdf)
PDF_PARSER=pypdf

# --- Model Arena sandbox for uploaded models (v1.2) ---------------------------
ARENA_SANDBOX=true
ARENA_SANDBOX_MEMORY_MB=4096
ARENA_SANDBOX_TIMEOUT_S=1800

# --- automation (v1.2) -------------------------------------------------------
SCHEDULER_ENABLED=true
WORK_AGENT_ENABLED=true
# Folder the Work Agent may read and write (default: <DATA_DIR>/workspace)
# WORK_AGENT_WORKSPACE=E:\work\agent-workspace
