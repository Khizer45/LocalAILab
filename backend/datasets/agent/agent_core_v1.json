    },
    {
      "id": "ag-ms-04",
      "category": "multi_step",
      "prompt": "How many months of warranty do devices have, and how many weeks is that if a month has 4.345 weeks?",
      "expect": {
        "tool_calls": [
          {
            "name": "search_knowledge_base",
