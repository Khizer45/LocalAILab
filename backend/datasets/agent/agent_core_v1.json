          ]
        }
      },
      "reference": "Order A-1002 totals 120 EUR."
    },
    {
      "id": "ag-ms-01",
      "category": "multi_step",
      "prompt": "What is the total of order A-1002 in Pakistani rupees?",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup_order",
            "arguments": {
              "order_id": "A-1002"
            }
          },
          {
            "name": "currency_converter",
            "arguments": {
              "amount": {
                "number": 120
              },
              "from_currency": {
                "regex": "(?i)^eur$"
              },
              "to_currency": {
                "regex": "(?i)^pkr$"
              }
            },
            "example": {
              "amount": 120,
              "from_currency": "EUR",
              "to_currency": "PKR"
            }
          }
        ],
        "order": "strict",
        "final_answer": {
          "type": "numeric",
          "value": 36521.74,
          "tolerance": 5
        }
      },
      "reference": "Order A-1002 costs 120 EUR, which is about 36,521.74 PKR."
    },
    {
      "id": "ag-ms-02",
      "category": "multi_step",
      "prompt": "Which city is warmer right now, Islamabad or Karachi?",
      "expect": {
        "tool_calls": [
          {
            "name": "get_weather",
            "arguments": {
              "city": "Islamabad"
            }
